<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="sofiaLibraryMagementSystemPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Register your entity classes here -->
        <class>com.hernancardona.model.entity.Book</class>
        <class>com.hernancardona.model.entity.Category</class>
        <class>com.hernancardona.model.entity.BookCopy</class>
        <!--
        <class>com.hernancardona.model.entity.Fine</class>
        <class>com.hernancardona.model.entity.Librarian</class>
        <class>com.hernancardona.model.entity.Loan</class>
        <class>com.hernancardona.model.entity.Member</class>
        <class>com.hernancardona.model.entity.Reservation</class>
        <class>com.hernancardona.model.entity.UserAccount</class>
        -->

        <properties>
            <!-- MySQL driver and credentials: REPLACE THE VALUES BELOW -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/your_database_name?serverTimezone=UTC&amp;allowPublicKeyRetrieval=true&amp;useSSL=false"/>
            <property name="jakarta.persistence.jdbc.user" value="your_username"/>
            <property name="jakarta.persistence.jdbc.password" value="your_password"/>

            <!-- Hibernate configuration -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>